# Strapi server
HOST=0.0.0.0
PORT=1337

# Secrets: generate your own, e.g. `openssl rand -base64 16` for each value.
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe
# Lifetime of the member JWT issued by /api/auth/local
JWT_EXPIRES_IN=7d

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=lerevenu
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
# Optional: a full connection string (e.g. Neon's direct, non-pooler one) overrides the values above.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Integration tests run against this separate database (created by docker/postgres/init)
TEST_DATABASE_NAME=lerevenu_test

# Password given to every demo member by `npm run seed` (local demo only, min. 8 chars)
SEED_USER_PASSWORD=Demo-Revenu-2026

# Local Strapi admin created by `npm run admin:create` (8+ chars, upper, lower, digit)
ADMIN_EMAIL=admin@demo.fr
ADMIN_PASSWORD=Admin-Demo-2026
